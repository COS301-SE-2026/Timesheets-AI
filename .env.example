#base URL should be changed to https://momentlyapp.org/ for production
APP_BASE_URL=http://localhost:4200

#AWS things
AWS_ACCOUNT_ID=<your_value_here>
AWS_REGION=<your_value_here>

AWS_S3_BUCKET=momently-prod-storage
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY

#DB
SPRING_DATASOURCE_USERNAME=<your_value_here>
SPRING_DATASOURCE_PASSWORD=<your_value_here>
SPRING_DATASOURCE_URL=<your_value_here>

SERVER_PORT=8080 

JWT_SECRET=<your_value_here>
JWT_EXPIRATION_MS=86400000
GOOGLE_CLIENT_ID=<your_value_here>
GOOGLE_CLIENT_SECRET=<your_value_here>
GOOGLE_REDIRECT_URI=http://localhost:8080/api/integrations/google/calendar/callback
MFA_ISSUER="Timesheets AI"
MFA_MAX_ATTEMPTS=5
MFA_LOCK_DURATION=30
MFA_CODE_LENGTH=6
SPRING_PROFILES_ACTIVE=dev

GOOGLE_CLIENT_ID_SSO=<your_value_here>
GOOGLE_CLIENT_SECRET_SSO=<your_value_here>
GOOGLE_REDIRECT_URI_SSO=http://localhost:4200/login


#Brevo Email configs
BREVO_SMTP_USERNAME=<your_value_here>
BREVO_SMTP_PASSWORD=<your_value_here>
BREVO_FROM_EMAIL=<your_value_here>
BREVO_FROM_NAME=<your_value_here>

EMAIL_VERIFICATION_EXPIRATION=24

# Frontend URL
APP_FRONTEND_URL=http://localhost:4200

#CORS config stuff
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200
APP_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
APP_CORS_ALLOWED_HEADERS=*
APP_CORS_ALLOW_CREDENTIALS=true

#AI credentials
GEMINI_API_KEY=<your_value_here>
AI_SERVICE_URL=<your_value_here>
BACKEND_URL=<your_value_here>

# Jira 
JIRA_CLIENT_ID=<your_value_here>
JIRA_CLIENT_SECRET=<your_value_here>
JIRA_REDIRECT_URI=http://localhost:8080/api/integrations/jira/callback

#GitHub
GITHUB_CLIENT_ID=<your_value_here>
GITHUB_CLIENT_SECRET=<your_value_here>
GITHUB_REDIRECT_URI=http://localhost:8080/api/integrations/github/callback