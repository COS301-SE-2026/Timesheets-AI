SPRING_DATASOURCE_USERNAME=username-here
SPRING_DATASOURCE_PASSWORD=password-here
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/momently_dev

SERVER_PORT=8080 

JWT_SECRET=dev-only-secret-replace-in-production-min-32-chars-abc123
JWT_EXPIRATION_MS=86400000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=http://localhost:8080/login/oauth2/code/google
GOOGLE_REDIRECT_URI=http://localhost:4200/login
MFA_ISSUER="Timesheets AI"
MFA_MAX_ATTEMPTS=5
MFA_LOCK_DURATION=30
MFA_CODE_LENGTH=6
SPRING_PROFILES_ACTIVE=dev


#Brevo Email configs
BREVO_SMTP_USERNAME=username_here
BREVO_SMTP_PASSWORD=password_here
BREVO_FROM_EMAIL=email_here
BREVO_FROM_NAME=name

#base URL should be changed to https://momentlyapp.org/ for production
APP_BASE_URL=http://localhost:4200


EMAIL_VERIFICATION_EXPIRATION=time

# Frontend URL
APP_FRONTEND_URL=http://localhost:4200

#CORS config stuff
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200
APP_CORS_ALLOWED_METHODS=methods
APP_CORS_ALLOWED_HEADERS=headers
APP_CORS_ALLOW_CREDENTIALS=bool_value

#AI credentials
GEMINI_API_KEY=the-api-key-for-gemini 

# Jira 
JIRA_CLIENT_ID=client_id
JIRA_CLIENT_SECRET=secret
JIRA_REDIRECT_URI=url_redirect


# GitHub OAuth
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_REDIRECT_URI=http://localhost:8080/api/integrations/github/callback

AI_SERVICE_URL=http://localhost:8000
