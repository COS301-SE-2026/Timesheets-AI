SPRING_DATASOURCE_USERNAME=username-here
SPRING_DATASOURCE_PASSWORD=password-here
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/momently_dev

SERVER_PORT=8080 

JWT_SECRET=dev-only-secret-replace-in-production-min-32-chars-abc123
JWT_EXPIRATION_MS=86400000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
MFA_ISSUER="Timesheets AI"
MFA_MAX_ATTEMPTS=5
MFA_LOCK_DURATION=30
MFA_CODE_LENGTH=6
EMAIL_FROM=noreply@timesheetai.com
EMAIL_VERIFICATION_EXPIRATION=24
SPRING_PROFILES_ACTIVE=dev


# Frontend URL
APP_FRONTEND_URL=http://localhost:4200

#CORS config stuff
APP_CORS_ALLOWED_ORIGINS=the-site-url
APP_CORS_ALLOWED_METHODS=methods
APP_CORS_ALLOWED_HEADERS=*
APP_CORS_ALLOW_CREDENTIALS=true

#AI credentials
GEMINI_API_KEY=the-api-key-for-gemini 