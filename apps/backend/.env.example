#this env should be in this backend directory, so we can have one here as well
#I also something about we should not be using localhost if we want it to work in Docker?? from the .env.example in the project root??
DB_NAME=momently_dev
DB_USERNAME=username-here
DB_PASSWORD=password-here
DATABASE_URL=jdbc:postgresql://localhost:5433/momently_dev
JWT_SECRET=dev-only-secret-replace-in-production-min-32-chars-abc123
JWT_EXPIRATION_MS=86400000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
MFA_ISSUER="Timesheets AI"
MFA_MAX_ATTEMPTS=5
MFA_LOCK_DURATION=30
MFA_CODE_LENGTH=6
EMAIL_FROM=noreply@timesheetai.com
EMAIL_VERIFICATION_EXPIRATION=24
SPRING_PROFILES_ACTIVE=dev

