DATABASE_URL=postgresql://your_username:your_password@localhost:5433/momently_dev
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
APP_ENV=development            # use production on any deployed server
LOG_LEVEL=info

BACKEND_URL=http://localhost:8080

# Production:
# BACKEND_URL=https://momentlyapp.org

# Shared secret the backend sends as X-Internal-Api-Key (same value as AI_SERVICE_API_KEY on the backend).
# Optional while APP_ENV=development, required everywhere else.
AI_SERVICE_API_KEY=

# Only needed if a browser origin must reach the service directly, normally leave empty
CORS_ALLOWED_ORIGINS=